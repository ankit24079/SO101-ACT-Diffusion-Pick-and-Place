# Copy to config/docker.env. Use numeric host values from id -u and id -g.
HOST_UID=
HOST_GID=
# Relative to the container's /calibration mount; select verified local calibration.
LEADER_CALIBRATION_RELATIVE=
# Hardware override only: numeric group IDs from stat -c %g on each device.
SERIAL_GID=
VIDEO_GID=
# Fill with VERIFIED persistent paths only after Stage 4 identification.
LEADER_PORT=
FOLLOWER_PORT=
WORKSPACE_CAMERA=
WRIST_CAMERA=
