# Copy to config/local.env only when ready to configure verified hardware.
# This is a template, not an executable recording configuration.
# Keep credentials out of this file and never commit the populated local copy.

# Absolute persistent /dev/serial/by-id paths, verified by disconnection in Stage 4.
LEADER_PORT=
FOLLOWER_PORT=

# Must match compatible existing calibration identities, checked in Stage 5.
LEADER_ID=
FOLLOWER_ID=

# Verified persistent camera paths; leave WRIST_CAMERA empty for one camera.
WORKSPACE_CAMERA=
WRIST_CAMERA=

# Proposed capture settings; verify support and timing before recording.
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
DATASET_FPS=30

# Local output paths, relative to the project root unless later tooling says otherwise.
DATASET_DIR=./datasets
OUTPUT_DIR=./outputs
LOG_DIR=./logs

# Populate only after the test recording workflow has been validated.
DATASET_REPO_ID=
TASK_DESCRIPTION="Pick up the cup and place it in the target area."
EPISODE_DURATION_SECONDS=
RESET_DURATION_SECONDS=
TARGET_SUCCESSFUL_EPISODES=60
